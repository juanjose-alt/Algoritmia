Algoritmo CalcularPromedio
	Definir calificacionA, calificacionB, calificacionC Como Real
	Definir promedio Como Real
	Escribir 'Ingrese la primera calificacion:'
	Leer calificacionA
	Escribir 'Ingrese la segunda calificacion:'
	Leer calificacionB
	Escribir 'Ingrese la tercera calificacion:'
	Leer calificacionC
	promedio <- (calificacionA+calificacionB+calificacionC)/3
	Escribir 'El promedio de las tres notas es: ', promedio
FinAlgoritmo
